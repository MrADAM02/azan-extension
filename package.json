{
  "name": "azan-tab",
  "description": "Prayer times new tab extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build && node tests/e2e/settings.e2e.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "screenshots": "wxt build && node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/amiri-quran": "^5.3.0",
    "adhan": "^4.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "puppeteer-core": "^23.11.1",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
